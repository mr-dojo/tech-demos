# Required for a live model. Leave empty to run in demo mode.
OPENAI_API_KEY=

# Optional. Any OpenAI-compatible Chat Completions base URL.
OPENAI_BASE_URL=

# Optional. Defaults to gpt-5.2 (the OpenUI self-hosted template default).
OPENAI_MODEL=

# Demo mode streams canned OpenUI Lang through /api/chat (no model call).
# 1 — always on, even when OPENAI_API_KEY is set
# 0 — off; a missing key returns 503 instead of demo replies
# unset — on automatically when OPENAI_API_KEY is missing
MOCK_LLM=
